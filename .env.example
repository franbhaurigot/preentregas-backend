# Servidor
PORT=8080
NODE_ENV=development

# Base de datos
MONGO_URL=mongodb://localhost:27017/eventos

# Autenticacion
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1h
COOKIE_NAME=currentUser

# Email (opcional: si no se completa, el envio se omite sin romper la app)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_cuenta@gmail.com
MAIL_PASS=tu_app_password
MAIL_FROM="Plataforma de Eventos <tu_cuenta@gmail.com>"
